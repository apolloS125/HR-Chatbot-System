# PostgreSQL
POSTGRES_DB=hr_chatbot
POSTGRES_USER=hr
POSTGRES_PASSWORD=change-this-database-password

# URL สาธารณะของ FastAPI (ต้องเป็น HTTPS เมื่อเชื่อม LINE จริง)
PUBLIC_BASE_URL=https://your-domain.example.com

# LINE Login channel
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Messaging API channel ใต้ Provider เดียวกับ LINE Login
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# เปลี่ยนทุกค่าก่อนใช้งานจริง
ADMIN_API_KEY=change-this-to-a-long-random-value
HR_USERNAME=hr
HR_PASSWORD=change-this-dashboard-password
HR_DISPLAY_NAME=HR
