# Data services
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DATABASE=hr_chatbot
REDIS_URL=redis://redis:6379/0
WEAVIATE_URL=http://weaviate:8080
SEAWEED_MASTER_URL=http://seaweedfs:9333

# URL สาธารณะของ FastAPI (ต้องเป็น HTTPS เมื่อเชื่อม LINE จริง)
PUBLIC_BASE_URL=https://your-domain.example.com

# LINE Login channel
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Messaging API channel ใต้ Provider เดียวกับ LINE Login
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF Mini App
# ตั้ง Endpoint URL ใน LINE Developers เป็น https://your-frontend-domain.example.com/liff
NEXT_PUBLIC_LIFF_ID=
PUBLIC_BACKEND_URL=https://your-backend-domain.example.com
LIFF_ORIGIN=https://your-frontend-domain.example.com
LIFF_SESSION_SECRET=change-this-to-a-long-random-value

# Optional: ให้ LLM เรียบเรียงคำตอบจาก FAQ ที่ค้นพบเท่านั้น
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# เปลี่ยนทุกค่าก่อนใช้งานจริง
ADMIN_API_KEY=change-this-to-a-long-random-value
HR_USERNAME=hr
HR_PASSWORD=change-this-dashboard-password
HR_DISPLAY_NAME=HR
